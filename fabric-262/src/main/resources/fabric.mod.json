{
  "schemaVersion": 1,
  "id": "buildertools",
  "version": "${version}",
  "name": "Builder Tools",
  "description": "WorldEdit-style builder tools for Minecraft: selection, entity, ruler, laser, paint, scatter and smooth tools with in-world visuals, a creative settings panel and a full command set.",
  "authors": [
    "Builder Tools contributors"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.buildertools.BuilderToolsMod",
      "io.github.favasur.fullslabs.fabric.FullSlabsFabric"
    ],
    "client": [
      "net.buildertools.BuilderToolsModClient"
    ]
  },
  "mixins": [
    "buildertools.mixins.json",
    "buildertools.flexiblepainting.mixins.json",
    "buildertools.smoothterrain.mixins.json",
    "fullslabs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
